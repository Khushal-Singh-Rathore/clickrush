# PostgreSQL Database URL
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/clickrush

# JWT Configuration
JWT_SECRET_KEY=change-this-to-a-secure-random-32-character-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Allowed Origins (JSON array format)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
